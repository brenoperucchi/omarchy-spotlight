#!/usr/bin/env python3
"""Bounded I/O broker for the Spotlight overlay.

Spotlight is a `keepLoaded` plugin: it lives inside the long-running
omarchy-shell process. Anything that process reads stays resident, so no read
may be open-ended. Every file read, every subprocess and every write that
Spotlight needs goes through this helper instead of happening in QML, and each
one is bounded three ways before the shell ever sees a byte:

  * a hard ceiling on how much is read,
  * a wall-clock deadline with a TERM -> KILL process-group teardown,
  * a normalised, count-limited projection as the only thing printed.

Every subcommand prints exactly one JSON object on stdout and exits 0. Failure
is `{"ok": false, "error": ...}` — the caller falls back to its defaults, so a
hostile or broken input degrades the feature instead of the shell.

Directories are opened as verified descriptors (owned by us, not group- or
world-writable) and every step of a path is opened relative to the previous
descriptor, so no ancestor can be swapped between the check and the use.
Directory components may be symlinks — `~/.config` pointing into a dotfiles
repo is a normal setup — but the descriptor they resolve to still has to pass
the ownership check. File components are opened O_NOFOLLOW and must be regular
files owned by us, which is what keeps a planted symlink, FIFO or device out.
"""

import errno
import fcntl
import json
import os
import re
import select
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import time

EUID = os.geteuid()
ACTIVE_PROC = None

# ------------------------------------------------------------------ limits
SETTINGS_BYTES = 64 * 1024
USAGE_BYTES = 256 * 1024
CLIPBOARD_BYTES = 8 * 1024 * 1024
ICS_BYTES = 64 * 1024

USAGE_KEEP = 400
USAGE_KEY_LEN = 256
USAGE_KEY_RE = re.compile(r"^(?:app:|cmd:|bang\.)[^\x00-\x1f]{1,240}$")

CLIP_ENTRIES = 200
CLIP_TITLE_CHARS = 120
CLIP_TEXT_BYTES = 1024 * 1024

SUGGEST_BYTES = 64 * 1024
SUGGEST_DEADLINE = 3.0
SUGGEST_COUNT = 8
SUGGEST_CHARS = 200
SUGGEST_QUERY_CHARS = 200

FILES_BYTES = 256 * 1024
FILES_DEADLINE = 3.0
FILES_COUNT = 40
FILES_PATH_CHARS = 1024
FILES_PATTERN_CHARS = 256
FILES_MAX_TERMS = 8

REMINDER_BYTES = 256 * 1024
REMINDER_DEADLINE = 3.0
REMINDER_COUNT = 50
REMINDER_FIELD_CHARS = 200

ICS_STAMP_RE = re.compile(r"^[0-9TZ]{1,32}$")

# The packaged list of desktop ids Omarchy keeps out of its own launcher.
# It lives under /usr/share, so it is the one read that is not ours: root
# owns it, and root is the only other owner any read here will accept.
OMARCHY_FALLBACK_PATH = "/usr/share/omarchy"
HIDES_PARTS = ("default", "omarchy")
HIDES_NAME = "launcher.hides"
HIDES_BYTES = 64 * 1024
HIDES_COUNT = 400
HIDES_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$")
SYSTEM_OWNERS = (0, EUID)

# The real Omarchy root-menu tree (JSONC: default + a user-writable
# extension, merged the same way Menu.qml's own MenuModel.js does - later
# entries override earlier fields, not whole entries). Read-only: nothing
# here is ever written back.
MENU_PARTS = ("default", "omarchy")
MENU_NAME = "omarchy-menu.jsonc"
MENU_USER_PARTS = (".config", "omarchy", "extensions")
MENU_JSONC_BYTES = 256 * 1024
MENU_MAX_ITEMS = 400
MENU_SKIP_PREFIXES = ("install.", "remove.", "system.")
# Only omarchy's own wrapped commands - the same posture Commands.js already
# committed to (its own comment: no Suspend row, because a bare `systemctl
# suspend` would cost the marketplace listing its automatic Verified status).
# Pulling the menu tree in wholesale would silently reintroduce exactly that
# without this gate: the tree's own system.suspend/system.hibernate entries
# call `systemctl` directly. (In practice system.* is excluded above anyway -
# Commands.js already curates that whole subtree by hand - but the gate holds
# even if that changes.)
MENU_ACTION_PREFIX = "omarchy-"
MENU_ARGV_TOKENS = 12
MENU_ARGV_CHARS = 512
MENU_LABEL_CHARS = 200
MENU_BREADCRUMB_DEPTH = 6
MENU_PKG_LIST_DEADLINE = 2.0
MENU_PKG_LIST_BYTES = 512 * 1024
# A real shell operator in the action string - not a leftover $VAR, which is
# handled separately (only $HOME/~ are expanded, as plain substitution, never
# through a shell). Conservative on purpose: unrecognised syntax is excluded,
# never guessed at.
MENU_SHELL_OPERATOR_RE = re.compile(r"(\|\||&&|;|\$\(|`|\bif\b|\bthen\b|\belif\b|\bfi\b|>>|<<|(?<!\|)\|(?!\|))")
MENU_WHEN_PKG_RE = re.compile(r"^(!\s*)?omarchy-pkg-present\s+(\S+)$")
MENU_WHEN_CMD_RE = re.compile(r"^(!\s*)?omarchy-cmd-present\s+(\S+)$")
MENU_WHEN_PATH_RE = re.compile(r"^\[\[\s*(!\s*)?-([df])\s+(\S+)\s*\]\]$")


class Denied(Exception):
    """Any boundary violation. Always fails closed."""


# ------------------------------------------------------------ descriptors
def _verify_dir(fd, label, owners=(EUID,)):
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode):
        raise Denied("%s is not a directory" % label)
    if st.st_uid not in owners:
        raise Denied("%s is not owned by an accepted user" % label)
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise Denied("%s is group- or world-writable" % label)


def home_fd():
    home = os.environ.get("HOME", "")
    if not home.startswith("/"):
        raise Denied("HOME is not an absolute path")
    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        _verify_dir(fd, "HOME")
    except Exception:
        os.close(fd)
        raise
    return fd


def dir_at(parent, name, create=False):
    """Open `name` under `parent` as a verified directory descriptor."""
    if create:
        try:
            os.mkdir(name, 0o700, dir_fd=parent)
        except FileExistsError:
            pass
        except OSError as exc:
            raise Denied("cannot create %s: %s" % (name, exc.strerror))
    fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC, dir_fd=parent)
    try:
        _verify_dir(fd, name)
    except Exception:
        os.close(fd)
        raise
    return fd


def walk(parts, create=False):
    """Resolve a chain of directory names below $HOME, one descriptor at a time."""
    fd = home_fd()
    for part in parts:
        nxt = dir_at(fd, part, create=create)
        os.close(fd)
        fd = nxt
    return fd


def system_dir(path):
    """Open an absolute system directory, verifying every component in turn.

    Same walk as walk(), one descriptor per component so no ancestor can be
    swapped between the check and the use, with root allowed as an owner
    alongside us. Nothing outside Omarchy's own install prefix is read this
    way, and nothing read this way is ever written.
    """
    if not path.startswith("/"):
        raise Denied("system path is not absolute")
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        _verify_dir(fd, "/", SYSTEM_OWNERS)
        for part in [p for p in path.split("/") if p]:
            if part == "..":
                raise Denied("system path escapes upward")
            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nxt
            _verify_dir(fd, part, SYSTEM_OWNERS)
    except Exception:
        os.close(fd)
        raise
    return fd


def read_file(dirfd, name, cap, owners=(EUID,)):
    """Read at most `cap` bytes from a regular file we own, never following a symlink."""
    try:
        # O_NONBLOCK so a FIFO planted at this name cannot block the open
        # itself; the S_ISREG check below then rejects it outright.
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                     dir_fd=dirfd)
    except FileNotFoundError:
        return None
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.EMLINK):
            raise Denied("%s is a symlink" % name)
        raise Denied("cannot open %s: %s" % (name, exc.strerror))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Denied("%s is not a regular file" % name)
        if st.st_uid not in owners:
            raise Denied("%s is not owned by an accepted user" % name)
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise Denied("%s is group- or world-writable" % name)
        if st.st_size > cap:
            raise Denied("%s is larger than %d bytes" % (name, cap))
        os.set_blocking(fd, True)
        chunks = []
        total = 0
        while total <= cap:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            total += len(chunk)
            chunks.append(chunk)
        if total > cap:
            raise Denied("%s grew past %d bytes while reading" % (name, cap))
        return b"".join(chunks)
    finally:
        os.close(fd)


def read_json(dirfd, name, cap, fallback):
    raw = read_file(dirfd, name, cap)
    if raw is None:
        return fallback
    try:
        return json.loads(raw.decode("utf-8", "replace"))
    except ValueError:
        return fallback


def lock_at(dirfd, name):
    """An exclusive advisory lock on a regular file we own. Never truncates."""
    fd = os.open(name, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
                 0o600, dir_fd=dirfd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != EUID:
            raise Denied("%s is not a regular file owned by this user" % name)
        fcntl.flock(fd, fcntl.LOCK_EX)
    except Exception:
        os.close(fd)
        raise
    return fd


def write_atomic(dirfd, name, payload):
    """Publish `payload` at `name` by renaming a private 0600 temp, dir-fd-relatively."""
    tmp = ".%s.tmp.%d" % (name, os.getpid())
    try:
        os.unlink(tmp, dir_fd=dirfd)
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                 0o600, dir_fd=dirfd)
    try:
        view = memoryview(payload)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.replace(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
    except Exception:
        try:
            os.unlink(tmp, dir_fd=dirfd)
        except OSError:
            pass
        raise
    os.fsync(dirfd)


# ------------------------------------------------------------ subprocesses
def run_bounded(argv, cap, deadline, stdin_bytes=None):
    """Run `argv`, returning at most `cap` bytes of stdout within `deadline`.

    The child gets its own session, so the deadline tears down the whole
    process group rather than just the leader — `fd` spawning threads or curl
    hanging on a socket cannot outlive the call. Reaching either bound is not
    an error: the caller works with the bounded prefix.
    """
    global ACTIVE_PROC
    blocked = {signal.SIGINT, signal.SIGTERM}
    old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, blocked)
    try:
        proc = subprocess.Popen(
            argv,
            stdin=subprocess.PIPE if stdin_bytes is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        ACTIVE_PROC = proc
    except OSError as exc:
        raise Denied("cannot run %s: %s" % (argv[0], exc.strerror))
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)

    out = proc.stdout
    try:
        if stdin_bytes is not None:
            try:
                proc.stdin.write(stdin_bytes)
            except OSError:
                pass
            try:
                proc.stdin.close()
            except OSError:
                pass

        fd = out.fileno()
        os.set_blocking(fd, False)
        end = time.monotonic() + deadline
        chunks = []
        total = 0
        truncated = False

        while True:
            remaining = end - time.monotonic()
            if remaining <= 0:
                truncated = True
                break
            ready, _, _ = select.select([fd], [], [], min(remaining, 0.25))
            if not ready:
                continue
            try:
                chunk = os.read(fd, 65536)
            except BlockingIOError:
                continue
            except OSError:
                break
            if not chunk:
                break
            room = cap - total
            if len(chunk) >= room:
                chunks.append(chunk[:room])
                truncated = True
                break
            chunks.append(chunk)
            total += len(chunk)
        return b"".join(chunks), truncated
    finally:
        _reap(proc)
        if ACTIVE_PROC is proc:
            ACTIVE_PROC = None
        try:
            out.close()
        except OSError:
            pass


def _reap(proc):
    """TERM the whole process group, then KILL it, then wait. Never leaves a child."""
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError:
        if proc.poll() is None:
            try:
                proc.terminate()
            except OSError:
                pass
    try:
        proc.wait(timeout=0.5)
    except subprocess.TimeoutExpired:
        pass

    # Always address the group once more: its leader may have exited while a
    # descendant remains alive with the same process-group id.
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except OSError:
        if proc.poll() is None:
            try:
                proc.kill()
            except OSError:
                pass
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        pass


def _handle_termination(signum, _frame):
    proc = ACTIVE_PROC
    if proc is not None:
        _reap(proc)
    raise SystemExit(128 + signum)


# --------------------------------------------------------------- clamping
def clamp_text(value, chars):
    s = "" if value is None else str(value)
    s = "".join(ch for ch in s if ch == "\t" or ch >= " " or ch == "\n")
    return s[:chars]


def clamp_int(value, low, high, default):
    try:
        n = int(value)
    except (TypeError, ValueError):
        return default
    return max(low, min(high, n))


def clamp_bool(value, default):
    return bool(value) if isinstance(value, bool) else default


def read_stdin(cap):
    data = sys.stdin.buffer.read(cap + 1)
    if len(data) > cap:
        raise Denied("stdin exceeded %d bytes" % cap)
    return data


def emit(payload):
    payload["ok"] = True
    sys.stdout.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))
    sys.stdout.write("\n")


# ------------------------------------------------------------- normalizers
def normalize_settings(parsed):
    out = {
        "webSuggestions": False,
        "searchEngine": "g",
        "fileSearch": True,
        "fileSearchAlways": False,
        "maxApps": 8,
        "maxSuggestions": 4,
    }
    if not isinstance(parsed, dict):
        return out
    out["webSuggestions"] = clamp_bool(parsed.get("webSuggestions"), False)
    out["fileSearch"] = clamp_bool(parsed.get("fileSearch"), True)
    out["fileSearchAlways"] = clamp_bool(parsed.get("fileSearchAlways"), False)
    out["maxApps"] = clamp_int(parsed.get("maxApps"), 3, 24, 8)
    out["maxSuggestions"] = clamp_int(parsed.get("maxSuggestions"), 0, SUGGEST_COUNT, 4)
    engine = parsed.get("searchEngine")
    if isinstance(engine, str) and re.match(r"^[A-Za-z]{1,8}$", engine):
        out["searchEngine"] = engine.lower()
    return out


def normalize_usage(parsed):
    """Keep only well-formed entries under keys Spotlight itself mints.

    The prefix test is what stops a hand-edited store introducing keys with
    special meaning in a JS object — `__proto__` never matches it — and the
    count cap is applied before anything is emitted, not after.
    """
    if not isinstance(parsed, dict):
        return {}
    now = int(time.time() * 1000)
    kept = []
    for key, value in parsed.items():
        if not isinstance(key, str) or len(key) > USAGE_KEY_LEN:
            continue
        if not USAGE_KEY_RE.match(key):
            continue
        if not isinstance(value, dict):
            continue
        count = clamp_int(value.get("count"), 0, 1000000, 0)
        last = clamp_int(value.get("last"), 0, now + 86400000, 0)
        if count <= 0:
            continue
        kept.append((key, count, last))
        if len(kept) >= USAGE_KEEP * 4:
            break
    kept.sort(key=lambda e: e[2], reverse=True)
    return {k: {"count": c, "last": l} for k, c, l in kept[:USAGE_KEEP]}


# ------------------------------------------------------------- omarchy menu
def _menu_strip_jsonc(raw):
    """JSONC -> JSON: line comments and trailing commas, nothing else.

    Matches MenuModel.js's own stripJsonc exactly (same two regexes), so a
    file the real menu accepts parses here the same way.
    """
    text = raw.decode("utf-8", "replace") if raw is not None else ""
    text = re.sub(r"^[ \t]*//[^\n]*$", "", text, flags=re.M)
    text = re.sub(r",(\s*[}\]])", r"\1", text)
    return text


def _menu_parse_items(raw):
    """Raw JSONC bytes -> {id: entry-dict}. Never raises; bad input is empty."""
    text = _menu_strip_jsonc(raw)
    if not text.strip():
        return {}
    try:
        parsed = json.loads(text)
    except ValueError:
        return {}
    if not isinstance(parsed, dict):
        return {}
    source = parsed.get("items") if isinstance(parsed.get("items"), dict) else parsed
    out = {}
    for item_id, entry in source.items():
        if not isinstance(item_id, str) or not isinstance(entry, dict):
            continue
        out[item_id] = entry
    return out


def _menu_read_default():
    base = os.environ.get("OMARCHY_PATH", "").strip() or OMARCHY_FALLBACK_PATH
    fd = system_dir(base.rstrip("/") + "/" + "/".join(MENU_PARTS))
    try:
        return read_file(fd, MENU_NAME, MENU_JSONC_BYTES, SYSTEM_OWNERS)
    finally:
        os.close(fd)


def _menu_read_user():
    """The user's own extension file. Its directory is allowed not to exist
    yet - most users never touch this - which is not the same failure as a
    directory that exists but fails ownership/permission checks, so only the
    former is swallowed here.
    """
    try:
        fd = walk(list(MENU_USER_PARTS))
    except FileNotFoundError:
        return None
    try:
        return read_file(fd, MENU_NAME, MENU_JSONC_BYTES)
    finally:
        os.close(fd)


def _menu_merge(default_items, user_items):
    """Field-by-field merge, later source wins - same semantics as
    MenuModel.js's mergeMenuSources: reusing an id extends/overrides it, it
    does not replace it outright.
    """
    merged = {}
    order = []
    for source in (default_items, user_items):
        for item_id, entry in source.items():
            if item_id not in merged:
                order.append(item_id)
                merged[item_id] = {}
            merged[item_id].update(entry)
    return merged, order


def _menu_parent(item_id, entry):
    parent = entry.get("parent")
    if isinstance(parent, str):
        return parent
    if item_id == "root":
        return ""
    if "." in item_id:
        return item_id.rsplit(".", 1)[0]
    return "root"


def _menu_breadcrumb(item_id, merged):
    """Ancestor labels, root-to-parent, joined for a subtitle - `Style ›
    Font` rather than a bare `Font`, since dozens of leaves share generic
    labels (`Default`, `Theme`, `Chrome`) that only their place in the tree
    disambiguates.
    """
    parts = []
    seen = set()
    current = merged.get(item_id, {}).get("_parent", "")
    while current and current != "root" and current not in seen and len(parts) < MENU_BREADCRUMB_DEPTH:
        seen.add(current)
        entry = merged.get(current)
        if not entry:
            break
        label = entry.get("label")
        if isinstance(label, str) and label:
            parts.append(label)
        current = entry.get("_parent", "")
    parts.reverse()
    return " › ".join(parts)


def _menu_resolve_argv(action):
    """A config-supplied command line -> an argv vector, or None if it can't
    be one without a real shell. Never returns something that was not
    tokenised by shlex - no string is ever handed to a shell here.

    $HOME and a leading ~ are expanded as plain substitution (not shell
    expansion) because a handful of real entries are otherwise-plain argv
    that only need that one thing; a token still containing `$` afterwards
    means some other, unhandled expansion was in play, so it is rejected
    rather than passed through literally.
    """
    action = str(action or "").strip()
    if not action or MENU_SHELL_OPERATOR_RE.search(action):
        return None
    try:
        tokens = shlex.split(action)
    except ValueError:
        return None
    if not tokens or len(tokens) > MENU_ARGV_TOKENS:
        return None
    home = os.environ.get("HOME", "")
    resolved = []
    for token in tokens:
        if home:
            token = token.replace("$HOME", home)
        if token == "~" or token.startswith("~/"):
            token = home + token[1:]
        if "$" in token or "`" in token or len(token) > MENU_ARGV_CHARS:
            return None
        resolved.append(token)
    if not resolved[0].startswith(MENU_ACTION_PREFIX):
        return None
    return resolved


_INSTALLED_PACKAGES = None


def _menu_installed_packages():
    """`pacman -Qq` once per process, cached - answers every `omarchy-pkg-
    present` check in `when` without a subprocess per entry.
    """
    global _INSTALLED_PACKAGES
    if _INSTALLED_PACKAGES is not None:
        return _INSTALLED_PACKAGES
    raw, _ = run_bounded(["pacman", "-Qq"], MENU_PKG_LIST_BYTES, MENU_PKG_LIST_DEADLINE)
    _INSTALLED_PACKAGES = frozenset(raw.decode("utf-8", "replace").split())
    return _INSTALLED_PACKAGES


def _menu_when_allows(when):
    """Only a handful of declarative `when` shapes are answered here - a
    package or command present, a path existing - each resolved without a
    shell (a package-name lookup, a PATH search, a stat). Every other shape
    (hardware probes, `compgen`, arbitrary shell) is left showing rather
    than hidden: a row nobody's hardware can use is a dead click, a row that
    silently disappeared is a feature the user cannot find and cannot know
    why - worse in a launcher.
    """
    when = str(when or "").strip()
    if not when:
        return True

    m = MENU_WHEN_PKG_RE.match(when)
    if m:
        present = m.group(2) in _menu_installed_packages()
        return (not present) if m.group(1) else present

    m = MENU_WHEN_CMD_RE.match(when)
    if m:
        present = shutil.which(m.group(2)) is not None
        return (not present) if m.group(1) else present

    m = MENU_WHEN_PATH_RE.match(when)
    if m:
        negate, kind, path = m.group(1), m.group(2), m.group(3)
        home = os.environ.get("HOME", "")
        if home:
            path = path.replace("$HOME", home)
        if path == "~" or path.startswith("~/"):
            path = home + path[1:]
        exists = os.path.isdir(path) if kind == "d" else os.path.isfile(path)
        return (not exists) if negate else exists

    return True


def _menu_commands():
    """The real Omarchy root-menu tree, projected into the same row shape
    Commands.js already emits - Spotlight.qml's dispatch does not need to
    know these came from a different source. install.*/remove.* (package
    management, not what a launcher's fuzzy search is for, and the single
    largest source of `when` conditions) and system.* (already curated by
    hand in Commands.js, confirmation prompts included) are excluded by
    subtree; a `provider` entry pulls its rows from a runtime function/
    command rather than static data and is excluded rather than guessed at;
    an `action` this cannot turn into a plain argv vector is excluded rather
    than run through a shell.
    """
    default_items = _menu_parse_items(_menu_read_default())
    user_items = _menu_parse_items(_menu_read_user())
    merged, order = _menu_merge(default_items, user_items)
    for item_id, entry in merged.items():
        entry["_parent"] = _menu_parent(item_id, entry)

    rows = []
    for item_id in order:
        if len(rows) >= MENU_MAX_ITEMS:
            break
        if item_id.startswith(MENU_SKIP_PREFIXES) or item_id in ("install", "remove", "system"):
            continue
        entry = merged[item_id]
        if entry.get("provider"):
            continue
        argv = _menu_resolve_argv(entry.get("action"))
        if not argv:
            continue
        if not _menu_when_allows(entry.get("when")):
            continue
        label = clamp_text(entry.get("label") or item_id, MENU_LABEL_CHARS)
        if not label:
            continue
        aliases = entry.get("aliases")
        keywords = " ".join(a for a in aliases if isinstance(a, str)) if isinstance(aliases, list) else ""
        rows.append({
            "key": "menu:" + item_id,
            "title": label,
            "subtitle": _menu_breadcrumb(item_id, merged),
            "icon": clamp_text(entry.get("icon") or "", 8),
            "argv": argv,
            "keywords": clamp_text(keywords, MENU_LABEL_CHARS),
        })
    return rows


# ---------------------------------------------------------------- commands
def cmd_read_settings():
    fd = walk([".config", "omarchy"])
    try:
        parsed = read_json(fd, "spotlight.json", SETTINGS_BYTES, {})
    finally:
        os.close(fd)
    emit({"settings": normalize_settings(parsed)})


def cmd_read_hides():
    """The desktop ids Omarchy keeps out of its own launcher.

    Omarchy's AppLibrary filters these before it hands a list to the menu.
    When the shell withholds that library, Spotlight builds the list itself
    and has to apply the same filter, or it shows a page of entries the menu
    has always hidden.
    """
    base = os.environ.get("OMARCHY_PATH", "").strip() or OMARCHY_FALLBACK_PATH
    fd = system_dir(base.rstrip("/") + "/" + "/".join(HIDES_PARTS))
    try:
        raw = read_file(fd, HIDES_NAME, HIDES_BYTES, SYSTEM_OWNERS)
    finally:
        os.close(fd)

    hides = []
    for line in (raw or b"").decode("utf-8", "replace").splitlines():
        value = line.strip()
        if value.endswith(".desktop"):
            value = value[:-8]
        if HIDES_ID_RE.match(value):
            hides.append(value)
        if len(hides) >= HIDES_COUNT:
            break
    emit({"hides": hides})


def cmd_read_menu_commands():
    emit({"commands": _menu_commands()})


def cmd_read_usage():
    fd = walk([".local", "state", "omarchy"], create=True)
    try:
        parsed = read_json(fd, "spotlight-usage.json", USAGE_BYTES, {})
    finally:
        os.close(fd)
    emit({"usage": normalize_usage(parsed)})


def cmd_write_usage():
    raw = read_stdin(USAGE_BYTES)
    try:
        parsed = json.loads(raw.decode("utf-8", "replace")) if raw else {}
    except ValueError:
        raise Denied("usage payload is not JSON")
    usage = normalize_usage(parsed)
    payload = json.dumps(usage, separators=(",", ":")).encode("utf-8")

    fd = walk([".local", "state", "omarchy"], create=True)
    try:
        lock = lock_at(fd, ".spotlight-usage.lock")
        try:
            write_atomic(fd, "spotlight-usage.json", payload)
        finally:
            os.close(lock)
    finally:
        os.close(fd)
    emit({"written": len(usage)})


def _clipboard_entries():
    fd = walk([".local", "state", "omarchy"], create=True)
    try:
        parsed = read_json(fd, "clipboard-history.json", CLIPBOARD_BYTES, [])
    finally:
        os.close(fd)
    if not isinstance(parsed, list):
        return []
    out = []
    for item in parsed:
        if len(out) >= CLIP_ENTRIES:
            break
        if not isinstance(item, dict) or item.get("type") != "text":
            continue
        text = item.get("text")
        if not isinstance(text, str) or not text.strip():
            continue
        out.append(text)
    return out


def cmd_read_clipboard():
    """Titles only.

    The full clipboard text is deliberately left on disk: a history holding
    tokens and passwords has no business being resident in a shell process
    that outlives the query. `clipboard-copy` re-reads the one entry the user
    picked and pipes it straight to wl-copy, so it never crosses this boundary.
    """
    entries = _clipboard_entries()
    rows = []
    for index, text in enumerate(entries):
        flat = re.sub(r"\s+", " ", text).strip()
        if not flat:
            continue
        title = flat[:CLIP_TITLE_CHARS] + ("…" if len(flat) > CLIP_TITLE_CHARS else "")
        rows.append({"index": index, "title": title, "bytes": len(text.encode("utf-8"))})
    emit({"items": rows})


def cmd_clipboard_copy(argv):
    if len(argv) != 2:
        raise Denied("clipboard-copy takes an index and a title")
    index = clamp_int(argv[0], 0, CLIP_ENTRIES - 1, -1)
    if index < 0:
        raise Denied("bad clipboard index")
    entries = _clipboard_entries()
    if index >= len(entries):
        raise Denied("clipboard entry is gone")
    text = entries[index]
    # The history may have shifted between listing and activation, so the row
    # the user actually saw is re-identified by its title before anything is
    # put on the clipboard.
    flat = re.sub(r"\s+", " ", text).strip()
    expected = flat[:CLIP_TITLE_CHARS] + ("…" if len(flat) > CLIP_TITLE_CHARS else "")
    if expected != argv[1]:
        raise Denied("clipboard entry changed")
    payload = text.encode("utf-8")[:CLIP_TEXT_BYTES]
    # Not run_bounded: wl-copy forks a daemon that has to outlive this call in
    # order to serve the selection, and tearing down the process group would
    # take that daemon with it. A plain bounded wait on the parent is right
    # here — the input is a fixed size and the argv has no operands at all.
    try:
        subprocess.run(["wl-copy"], input=payload, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Denied("wl-copy failed: %s" % type(exc).__name__)
    emit({"copied": len(payload)})


def cmd_reminders():
    raw, _ = run_bounded(["omarchy-reminder", "show", "--json"],
                         REMINDER_BYTES, REMINDER_DEADLINE)
    try:
        parsed = json.loads(raw.decode("utf-8", "replace")) if raw else {}
    except ValueError:
        parsed = {}
    items = parsed.get("reminders") if isinstance(parsed, dict) else None
    rows = []
    if isinstance(items, list):
        for item in items[:REMINDER_COUNT]:
            if not isinstance(item, dict):
                continue
            rows.append({
                "label": clamp_text(item.get("label"), REMINDER_FIELD_CHARS),
                "remaining": clamp_text(item.get("remaining"), REMINDER_FIELD_CHARS),
                "atTime": clamp_text(item.get("atTime"), REMINDER_FIELD_CHARS),
            })
    emit({"reminders": rows})


def cmd_suggest(argv):
    if len(argv) != 1:
        raise Denied("suggest takes one query")
    query = clamp_text(argv[0], SUGGEST_QUERY_CHARS).strip()
    if not query:
        emit({"suggestions": []})
        return
    # The endpoint is built here rather than passed in, so nothing upstream can
    # steer the request at a different host.
    from urllib.parse import quote
    url = ("https://suggestqueries.google.com/complete/search"
           "?client=firefox&hl=en&q=" + quote(query, safe=""))
    raw, truncated = run_bounded(
        ["curl", "-sf", "--proto", "=https", "--max-time", "2", "--connect-timeout", "2",
         "--max-filesize", str(SUGGEST_BYTES), "--compressed", "--", url],
        SUGGEST_BYTES, SUGGEST_DEADLINE)
    if truncated:
        emit({"suggestions": []})
        return
    try:
        parsed = json.loads(raw.decode("utf-8", "replace")) if raw else []
    except ValueError:
        parsed = []
    items = parsed[1] if isinstance(parsed, list) and len(parsed) > 1 else []
    out = []
    if isinstance(items, list):
        for item in items[:SUGGEST_COUNT * 4]:
            if len(out) >= SUGGEST_COUNT:
                break
            if not isinstance(item, str):
                continue
            s = clamp_text(item, SUGGEST_CHARS).strip()
            if s:
                out.append(s)
    emit({"suggestions": out})


def cmd_files(argv):
    if len(argv) != 2:
        raise Denied("files takes a directory and a pattern")
    directory = argv[0]
    pattern = clamp_text(argv[1], FILES_PATTERN_CHARS)
    if not directory.startswith("/") or len(directory) > FILES_PATH_CHARS or not pattern.strip():
        raise Denied("bad file search target")
    try:
        probe = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError:
        emit({"files": []})
        return
    os.close(probe)

    # A query like "PMJ XLS" is two terms a user expects ANDed together (one
    # for the name, one for the extension), not one literal substring — `fd`
    # takes the first positional pattern plus any number of --and patterns,
    # so the split lands directly on its own multi-pattern support (fd >= 9.0).
    #
    # --ignore-case overrides fd's own smart-case, under which a term typed
    # in caps (an extension, an acronym) would otherwise force case-sensitive
    # matching on that one term and silently drop real hits — "XLS" not
    # matching ".xlsx" is what a user actually typing this feature hits.
    # Spotlight, the target this plugin models itself on, is not case
    # sensitive either.
    terms = pattern.split()[:FILES_MAX_TERMS]
    fd_argv = ["fd", "--hidden", "--follow", "--one-file-system", "--ignore-case",
               "--exclude", ".git", "--exclude", "node_modules", "--exclude", ".cache",
               "--max-results", str(FILES_COUNT)]
    for term in terms[1:]:
        fd_argv += ["--and", term]
    fd_argv += ["--", terms[0], directory]

    raw, _ = run_bounded(fd_argv, FILES_BYTES, FILES_DEADLINE)

    rows = []
    for line in raw.decode("utf-8", "replace").split("\n"):
        if len(rows) >= FILES_COUNT:
            break
        if not line or len(line) > FILES_PATH_CHARS:
            continue
        is_dir = line.endswith("/")
        path = line[:-1] if is_dir else line
        if not path:
            continue
        slash = path.rfind("/")
        rows.append({
            "path": path,
            "name": path[slash + 1:] if slash >= 0 else path,
            "dir": path[:slash] if slash > 0 else "/",
            "isDir": is_dir,
        })
    emit({"files": rows})


def cmd_write_ics(argv):
    if len(argv) != 1 or not ICS_STAMP_RE.match(argv[0]):
        raise Denied("bad event stamp")
    body = read_stdin(ICS_BYTES)
    if not body:
        raise Denied("empty event")

    downloads = os.environ.get("XDG_DOWNLOAD_DIR", "")
    home = os.environ.get("HOME", "")
    name = "Downloads"
    if downloads.startswith(home + "/") and "/" not in downloads[len(home) + 1:]:
        name = downloads[len(home) + 1:]
    fd = walk([name], create=True)
    try:
        # O_EXCL is the whole symlink defence: a name that already exists —
        # including one that exists only as a dangling symlink — is never
        # opened, it is stepped over.
        for attempt in range(20):
            suffix = "" if attempt == 0 else "-%d" % attempt
            filename = "omarchy-event-%s%s.ics" % (argv[0], suffix)
            try:
                out = os.open(filename,
                              os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                              0o600, dir_fd=fd)
            except FileExistsError:
                continue
            try:
                view = memoryview(body)
                while view:
                    view = view[os.write(out, view):]
                os.fsync(out)
            finally:
                os.close(out)
            emit({"path": os.path.join(home, name, filename)})
            return
        raise Denied("could not find a free filename")
    finally:
        os.close(fd)


# name -> (handler, whether it reads positional arguments)
COMMANDS = {
    "read-settings": (cmd_read_settings, False),
    "read-usage": (cmd_read_usage, False),
    "read-hides": (cmd_read_hides, False),
    "read-menu-commands": (cmd_read_menu_commands, False),
    "write-usage": (cmd_write_usage, False),
    "read-clipboard": (cmd_read_clipboard, False),
    "clipboard-copy": (cmd_clipboard_copy, True),
    "reminders": (cmd_reminders, False),
    "suggest": (cmd_suggest, True),
    "files": (cmd_files, True),
    "write-ics": (cmd_write_ics, True),
}


def main(argv):
    signal.signal(signal.SIGINT, _handle_termination)
    signal.signal(signal.SIGTERM, _handle_termination)
    if not argv or argv[0] not in COMMANDS:
        sys.stdout.write(json.dumps({"ok": False, "error": "unknown command"}) + "\n")
        return 0
    handler, takes_args = COMMANDS[argv[0]]
    try:
        handler(argv[1:]) if takes_args else handler()
    except Denied as exc:
        sys.stdout.write(json.dumps({"ok": False, "error": str(exc)}) + "\n")
    except Exception as exc:  # never let a traceback become the payload
        sys.stdout.write(json.dumps({"ok": False, "error": type(exc).__name__}) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
